				MATRIX_KEY(0x08, 0x01, KEY_F11)
				MATRIX_KEY(0x09, 0x05, KEY_F12)
				MATRIX_KEY(0x0b, 0x05, KEY_F13)
				MATRIX_KEY(0x0e, 0x0f, KEY_CAPSLOCK)
				MATRIX_KEY(0x09, 0x0b, KEY_DELETE)
				MATRIX_KEY(0x0f, 0x0c, KEY_HOME)
				MATRIX_KEY(0x0e, 0x0c, KEY_END)
				MATRIX_KEY(0x0f, 0x0b, KEY_PAGEUP)
				MATRIX_KEY(0x0e, 0x0b, KEY_PAGEDOWN)
				MATRIX_KEY(0x00, 0x04, KEY_DICTATE)
				MATRIX_KEY(0x00, 0x01, KEY_MUTE)
				MATRIX_KEY(0x01, 0x05, KEY_VOLUMEDOWN)
				MATRIX_KEY(0x03, 0x05, KEY_VOLUMEUP)
			>;
		};
	};
};

&smb2360_0 {
	status = "okay";
};

&smb2360_0_eusb2_repeater {
	vdd18-supply = <&vreg_l3d_1p8>;
	vdd3-supply = <&vreg_l2b_3p0>;
};

&smb2360_1 {
	status = "okay";
};

&smb2360_1_eusb2_repeater {
	vdd18-supply = <&vreg_l3d_1p8>;
	vdd3-supply = <&vreg_l14b_3p0>;
};

/* Stock wsa_swr_master 17641 under wsa-macro@6B00000 (swrm-io-base 0x6b10000 = swr0): pins LPI gpio10/11 (16697,
 * 16760) = wsa_swr_active; shutdown qcom,spkr-sd-n-node = wsa_spkr_en02 18214 = spkr_02_sd_n_active, TLMM gpio204
 * (5080), one pin for both codecs (GPIO_SHARED_PROXY). cdc-vdd-1p8-supply = pm_humu_l15 (10857) = L15B; vdd-io is
 * not in the stock codec nodes, L12B as on every a804c57 x1e80100 board (unverified). */
&swr0 {
	status = "okay";

	pinctrl-0 = <&wsa_swr_active>, <&spkr_02_sd_n_active>;
	pinctrl-names = "default";

	/* WSA8845, stock wsa884x@02170220 "SpkrLeft" 17658 (the last digit is the unique id) */
	left_woofer: speaker@0,0 {
		compatible = "sdw20217020400";
		reg = <0 0>;
		reset-gpios = <&tlmm 204 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "WooferLeft";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l12b_1p2>;
		qcom,port-mapping = <1 2 3 7 10 13>;
	};

	/* WSA8845, stock wsa884x@02170221 "SpkrRight" 17675 */
	left_tweeter: speaker@0,1 {
		compatible = "sdw20217020400";
		reg = <0 1>;
		reset-gpios = <&tlmm 204 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "TweeterLeft";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l12b_1p2>;
		qcom,port-mapping = <4 5 6 7 11 13>;
	};
};

/* Stock wsa2_swr_master under wsa2-macro@6AA0000 (swrm-io-base 0x6ab0000 = swr3): pins LPI gpio15/16 (17049,
 * 17112) = wsa2_swr_active; shutdown wsa_spkr_en13 18222 = spkr_13_sd_n_active, TLMM gpio205 (5115). */
&swr3 {
	status = "okay";

	pinctrl-0 = <&wsa2_swr_active>, <&spkr_13_sd_n_active>;
	pinctrl-names = "default";

	/* WSA8845, stock wsa884x_2_0220 "Spkr2Left" */
	right_woofer: speaker@0,0 {
		compatible = "sdw20217020400";
		reg = <0 0>;
		reset-gpios = <&tlmm 205 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "WooferRight";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l12b_1p2>;
		qcom,port-mapping = <1 2 3 7 10 13>;
	};

	/* WSA8845, stock wsa884x_2_0221 "Spkr2Right" */
	right_tweeter: speaker@0,1 {
		compatible = "sdw20217020400";
		reg = <0 1>;
		reset-gpios = <&tlmm 205 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "TweeterRight";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l12b_1p2>;
		qcom,port-mapping = <4 5 6 7 11 13>;
	};
};

&tlmm {
	/* Union of mica's stock <34 2>, <44 4> and the 9345's ranges */
	gpio-reserved-ranges = <34 2>,  /* reserved on stock mica */
			       <44 4>,  /* SPI11 */
			       <76 4>,  /* SPI19 (TZ Protected on the 9345) */
			       <238 1>; /* UFS Reset (9345) */

	ap_ec_int_l: ap-ec-int-l-state {
		pins = "gpio66";
		function = "gpio";
		bias-disable;
	};

	/* stock overlay (entry01 1374): dmic_pp3300_pin, the mic rail's enable */
	dmic_pp3300_en: dmic-pp3300-en-state {
		pins = "gpio69";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	edp_reg_en: edp-reg-en-state {
		pins = "gpio70";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
	};

	eusb5_reset_n: eusb5-reset-n-state {
		pins = "gpio10";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	eusb6_reset_n: eusb6-reset-n-state {
		pins = "gpio184";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	fpmcu_vcc_en: fpmcu-vcc-en-state {
		pins = "gpio22";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	nvme_reg_en: nvme-reg-en-state {
		pins = "gpio18";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	pcie4_default: pcie4-default-state {
		clkreq-n-pins {
			pins = "gpio147";
			function = "pcie4_clk";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio146";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio148";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	pcie6a_default: pcie6a-default-state {
		clkreq-n-pins {
			pins = "gpio153";
			function = "pcie6a_clk";
			drive-strength = <2>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio152";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		wake-n-pins {
			pins = "gpio154";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	/* Stock drive and bias for gpio55 (entry00-base.dts:3024-3028); function gpio for cs-gpios on &spi13 */
	qup_spi13_cs_gpio: qup-spi13-cs-gpio-state {
		pins = "gpio55";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
		output-high;
	};

	rtmr1_1p15_reg_en: rtmr1-1p15-reg-en-state {
		pins = "gpio188";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rtmr1_1p8_reg_en: rtmr1-1p8-reg-en-state {
		pins = "gpio175";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rtmr1_3p3_reg_en: rtmr1-3p3-reg-en-state {
		pins = "gpio186";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rtmr1_default: rtmr1-reset-n-active-state {
		pins = "gpio176";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* The speaker shutdown pins are on the SoC TLMM on mica (stock spkr_02_sd_n 5062, spkr_13_sd_n 5097; the Yoga
	 * has them on lpass_tlmm 12 and 13). Deviation: stock's active state drives them high; here they start low, as
	 * the Yoga's do, and the codec driver releases the reset itself (reset-gpios). */
	spkr_02_sd_n_active: spkr-02-sd-n-active-state {
		pins = "gpio204";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	spkr_13_sd_n_active: spkr-13-sd-n-active-state {
		pins = "gpio205";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	tpad_default: tpad-default-state {
		int-n-pins {
			pins = "gpio3";
			function = "gpio";
			bias-disable;
		};

		/*
		 * Stock: reset-gpios = <&tlmm 2 GPIO_ACTIVE_LOW>. Generic
		 * hid-over-i2c has no reset property, so hold it deasserted.
		 */
		reset-n-pins {
			pins = "gpio2";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	tpad_vdd_en: tpad-vdd-en-state {
		pins = "gpio36";
		function = "gpio";
		drive-strength = <2>;
		output-high;
	};

	tpm_int: tpm-int-state {
		pins = "gpio91";
		function = "gpio";
		bias-disable;
	};

	ts0_default: ts0-default-state {
		int-n-pins {
			pins = "gpio51";
			function = "gpio";
			bias-disable;
		};

		reset-n-pins {
			pins = "gpio48";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
			output-low;
		};

		report-en-pins {
			pins = "gpio89";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
			output-low;
		};
	};

	ts0_vdd_en: ts0-vdd-en-state {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	ucam_33v_en: ucam-33v-en-state {
		pins = "gpio206";
		function = "gpio";
		drive-strength = <2>;
		output-high;
	};

	wcn_sw_en: wcn-sw-en-state {
		pins = "gpio214";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	wcn_wlan_bt_en: wcn-wlan-bt-en-state {
		pins = "gpio116", "gpio117";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";
		max-speed = <3200000>;

		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
	};
};

&uart21 {
	compatible = "qcom,geni-debug-uart";
	status = "okay";
};

&usb_1_ss0_hsphy {
	vdd-supply = <&vreg_l3j_0p8>;
	vdda12-supply = <&vreg_l2j_1p2>;

	phys = <&smb2360_0_eusb2_repeater>;

	status = "okay";
};

&usb_1_ss0_qmpphy {
	vdda-phy-supply = <&vreg_l1j_0p9>;
	vdda-pll-supply = <&vreg_l2j_1p2>;

	status = "okay";
};

&usb_1_ss0 {
	dr_mode = "host";

	status = "okay";
};

&usb_1_ss0_dwc3_hs {
	remote-endpoint = <&pmic_glink_ss0_hs_in>;
};

&usb_1_ss0_qmpphy_out {
	remote-endpoint = <&retimer_ss0_ss_in>;
};

&usb_1_ss1_hsphy {
	vdd-supply = <&vreg_l3j_0p8>;
