				MATRIX_KEY(0x06, 0x0f, KEY_CONTEXTUAL_INSERT)
				MATRIX_KEY(0x04, 0x0a, KEY_FN)
				MATRIX_KEY(0x00, 0x0b, KEY_DELETE)
				MATRIX_KEY(0x02, 0x07, KEY_102ND)
				MATRIX_KEY(0x02, 0x0a, KEY_YEN)
				MATRIX_KEY(0x06, 0x0a, KEY_BACKSLASH)
				MATRIX_KEY(0x00, 0x02, KEY_BACK)
				MATRIX_KEY(0x03, 0x02, KEY_HOMEPAGE)
				MATRIX_KEY(0x02, 0x02, KEY_SCALE)
				MATRIX_KEY(0x01, 0x02, KEY_FULL_SCREEN)
				MATRIX_KEY(0x04, 0x04, KEY_SYSRQ)
