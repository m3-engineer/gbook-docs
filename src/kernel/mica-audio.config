# M3, audio (ticket 10, 2026-11-04): the sound card of the board DTS (dts/diag/sound.dtsi until 2026-11-05; 4x WSA8845 on swr0 and swr3, 4 DMICs on
# the VA macro, the ADSP's APM and PRM services over GPR). scripts/dt-kconfig-map.py on the sound -el2 DTB,
# 2026-11-04: every driver below was =m, and the initramfs loads no modules. The topology
# qcom/x1e80100/X1E80100-Dell-XPS-13-9345-tplg.bin is requested at the card's component probe
# (sound/soc/qcom/qdsp6/topology.c:1422, q6apm.c q6apm_audio_probe), so scripts/stage-firmware.sh puts it in the
# initramfs. Firmware-side: the stock ADSP (adsp.mdt) must offer the "avs/audio" protection domain; QCOM_PD_MAPPER
# and QCOM_PDR_HELPERS are =y already (pmic_glink uses them).

CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
# The card (qcom,x1e80100-sndcard); selects SND_SOC_QDSP6 (APM, PRM, topology), QCOM_COMMON and QCOM_SDW.
CONFIG_SND_SOC_X1E80100=y
CONFIG_SND_SOC_QDSP6=y
# GPR over glink to the ADSP (qcom,gpr); the APM and PRM services hang off it.
CONFIG_QCOM_APR=y
# The two SoundWire masters (qcom,soundwire-v2.0.0) and the WSA8845 slaves (sdw20217020400).
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SND_SOC_WSA884X=y
# The LPASS macros the card uses (qcom,sm8550-lpass-wsa-macro, -va-macro); RX and TX stay =m (headset codec off).
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
# The LPI pin controller (qcom,sm8550-lpass-lpi-pinctrl): SoundWire and DMIC pins.
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8550_LPASS_LPI=y
# The LPASS clock controllers (qcom,sc8280xp-lpassaudiocc, -lpasscc): the SoundWire masters' resets.
CONFIG_SC_LPASSCC_8280XP=y
# The speakers' shutdown pin: wsa884x.c:2022 asks the reset framework first (devm_reset_control_get_optional_shared),
# and for a reset-gpios property the reset core creates an auxiliary "reset-gpio" device (drivers/reset/core.c:936)
# and defers the codec until its driver binds. Attempt 2026-11-04-26: all four codecs "Failed to get reset" for the
# whole boot with this =m; the card then waits on them ("WSA Playback: codec dai not found").
CONFIG_RESET_GPIO=y
# Attempt 2026-11-04-27: the reset-gpio devices (one per pin, reset.gpio.0 and .1) then deferred on "Could not get reset
# gpios". TLMM 204 and 205 are each shared by two codecs; this kernel's shared-GPIO support (GPIO_SHARED=y,
# drivers/gpio/gpiolib-shared.c: a GPIO referenced by several consumers gets GPIOD_FLAG_SHARED, gpiolib.c:4807) routes
# every request for such a pin through a gpio-shared-proxy platform lookup (gpiolib.c:4805-4834); the lookup names
# the proxy's gpio chip, which only this driver registers, so gpiod_find defers until it binds.
CONFIG_GPIO_SHARED_PROXY=y

# Selected by the lines above; checked, not set.
# require: SND_SOC_QDSP6_COMMON
# require: SND_SOC_QDSP6_APM
# require: SND_SOC_QDSP6_APM_DAI
# require: SND_SOC_QDSP6_APM_LPASS_DAI
# require: SND_SOC_QDSP6_PRM
# require: SND_SOC_QDSP6_PRM_LPASS_CLOCKS
# require: SND_SOC_QCOM_COMMON
# require: SND_SOC_QCOM_SDW
# require: SND_SOC_TOPOLOGY
# require: SND_SOC_LPASS_MACRO_COMMON
# require: REGMAP_SOUNDWIRE
# require: QCOM_PDR_HELPERS
# require: QCOM_PD_MAPPER
# require: RPMSG_QCOM_GLINK_SMEM
