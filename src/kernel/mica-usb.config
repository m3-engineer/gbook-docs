# Phase 3, USB: build the whole USB chain in, so the module-free initramfs can use it.
# Merged after kernel/mica-firstboot.config by scripts/build-kernel.sh.
# Source: the first boot (docs/recon/firstboot-2026-11-02.md): all four dwc3 controllers stayed deferred
# ("failed to register DWC3 Core") because every PHY, repeater, retimer and I2C driver below was =m in defconfig
# at a804c57 and no module was loaded. Each line maps a compatible in x1e80100-google-mica-el2.dtb to its driver.

# I2C buses that carry the PS8830 retimers and PTN3222 redrivers (qcom,geni-i2c).
CONFIG_I2C_QCOM_GENI=y

# High-speed PHYs (qcom,x1e80100-snps-eusb2-phy -> drivers/phy/phy-snps-eusb2.c).
CONFIG_PHY_SNPS_EUSB2=y
# SMB2360 eUSB2 repeaters on SPMI (qcom,smb2360-eusb2-repeater).
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
# PTN3222 eUSB2 redrivers on i2c5 for usb_2 (nxp,ptn3222).
CONFIG_PHY_NXP_PTN3222=y

# SuperSpeed: Type-C ports (qcom,x1e80100-qmp-usb3-dp-phy) and the multiport controller (qmp-usb3-uni-phy).
# Their menu parent PHY_QCOM_QMP caps them (drivers/phy/qualcomm/Kconfig:53-125, "if PHY_QCOM_QMP"); defconfig has =m.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y

# Type-C class and the PS8830 retimers (parade,ps8830). QMP_COMBO depends on "TYPEC || TYPEC=n", so TYPEC
# must be =y or the combo PHY is pulled back to =m.
CONFIG_TYPEC=y
CONFIG_TYPEC_MUX_PS883X=y

# Type-C control through the ADSP (qcom,x1e80100-pmic-glink). Built in for later; it stays idle until the ADSP
# runs with its firmware (Phase 3 firmware work), and the ports are dr_mode = "host" meanwhile.
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y

# Already =y in defconfig; checked, not set.
# require: USB_DWC3
# require: USB_DWC3_QCOM
# require: USB_XHCI_HCD
# require: USB_XHCI_PLATFORM
# require: USB_STORAGE
# require: USB_HID
# require: USB_ROLE_SWITCH
# require: SPMI_MSM_PMIC_ARB
# require: MFD_SPMI_PMIC
