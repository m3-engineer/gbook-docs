# Phase 3, PCIe: bring up both PCIe controllers and enumerate their devices.
# Source: every boot so far left pcie@1bf8000 and pcie@1c08000 deferred ("Failed to parse Root Port: -517");
# scripts/dt-kconfig-map.py on the mica-el2 DTB shows their suppliers are =m in defconfig at a804c57.
#
# Safety: the NVMe slot holds the stock SSD, which is never written (ADR 0003, ticket 07). BLK_DEV_NVME stays =m
# (not loaded), so enumeration reads PCI config space only and no NVMe command reaches the SSD.

# QMP PCIe PHYs: gen4x4 phy@1bfc000 (pcie@1bf8000) and gen3x2 phy@1c0e000 (pcie@1c08000). Their menu parent
# PHY_QCOM_QMP is already =y in mica-usb.config.
CONFIG_PHY_QCOM_QMP_PCIE=y

# WCN7850 power: the PMU (qcom,wcn7850-pmu) and the PCI power control for wifi@0 (pci17cb,1107).
# PCI_PWRCTRL_PWRSEQ has no prompt; only ATH11K/ATH12K select it ("if HAVE_PWRCTRL"), so the ath12k driver is built
# in too. No Wi-Fi firmware is shipped: ath12k is expected to fail at firmware load after enumeration.
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_ATH12K=y
# ath12k "depends on MAC80211"; MAC80211 needs CFG80211, and CFG80211 needs RFKILL at least as high (all =m in
# defconfig). Without them build-kernel.sh reports ATH12K and PCI_PWRCTRL_PWRSEQ pulled back to =m.
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y

# Safety: the NVMe driver must stay out of the kernel until the owner approves a read-only NVMe step.
# forbid-y: BLK_DEV_NVME

# Checked, not set (selected or already =y).
# require: PCIE_QCOM
# require: PCIEPORTBUS
# require: PCI_MSI
# require: POWER_SEQUENCING
# require: PCI_PWRCTRL
# require: PCI_PWRCTRL_PWRSEQ
